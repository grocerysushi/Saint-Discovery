# Canonical public origin. Falls back to https://www.saintdiscoveryquiz.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.saintdiscoveryquiz.com

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# InsForge backend (see AGENTS.md). The public values are read by the browser
# client; INSFORGE_API_KEY is server-only and must never reach the browser.
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key
INSFORGE_API_KEY=your_insforge_admin_api_key

# Blog storage client (server-only). Falls back to the public values above.
INSFORGE_BLOG_URL=https://your-project.us-east.insforge.app
INSFORGE_BLOG_ANON_KEY=your_insforge_anon_key

# Transactional email through Resend. Required by /api/subscribe and /api/confirm.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Saint Discovery <hello@your-domain.example>"
RESEND_REPLY_TO=hello@your-domain.example
EMAIL_POSTAL_ADDRESS=Your postal address
# Must be at least 32 characters. Tokens fail closed when this is missing or short.
EMAIL_TOKEN_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Only set this to point confirmation links at a local dev server.
# EMAIL_LINK_BASE_URL=http://localhost:3000

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
