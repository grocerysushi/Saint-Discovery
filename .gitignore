# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-daily/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# insforge (contains project secrets)
.insforge/

# unrelated nested repo
/budget-tracker/

# AI tool configs
.CLAUDE/
.agent/
.agents/
.augment/
.kilocode/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/

# extended bio writer (Python) — cache and run logs
/scripts/__pycache__/
/scripts/logs/

# Generated classroom artifacts (served copies live in public/downloads)
/output/pdf/
/tmp/pdfs/

# Local Jev SEO reports (public-page evidence and API judgments)
/output/jev-seo/
/output/seo-improvements/
/output/quiz-choice-review/
/.next-jev-seo/
/.next-saints-200/

# 200-saint research: retain authored audit metadata, not copied source caches
/research/saints-expansion-200/*
!/research/saints-expansion-200/*audit.json
!/research/saints-expansion-200/*review.json
!/research/saints-expansion-200/*final-candidates.json
!/research/saints-expansion-200/integration-record.json
!/research/saints-expansion-200/browser-checks.json

# InsForge & AI agent skills
# Artwork research: retain authored provenance, exclude copied metadata and logs
/research/saint-artwork/candidates.json
/research/saint-artwork/*.log

